              "raw": "{\"status\":\"active\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/users/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "users",
                "1"
              ]
            }
          }
        }
      ]
