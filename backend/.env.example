# ─── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (PostgreSQL) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=volunteering_rewards
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_another_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
