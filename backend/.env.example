# ─── Volunteering Rewards App — Environment Config ─────
# Copy this file to .env and fill in your values.
#   cp backend/.env.example backend/.env
#
# ─── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (PostgreSQL) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=volunteering_rewards
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── JWT ─────────────────────────────────────────────────
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_a_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_another_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# ─── File Uploads ─────────────────────────────────────────
MAX_FILE_SIZE=1048576            # 1 MB in bytes
UPLOAD_DIR=./uploads
