# ─── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (PostgreSQL) ──────────────────────────────
# For production, DATABASE_URL is preferred (set via Render env vars)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=volunteering_rewards
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ─── JWT ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_hex_chars_access_secret
JWT_REFRESH_SECRET=replace_with_64_hex_chars_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── PIN Hashing ─────────────────────────────────────────
# Used for HMAC-SHA256 hashing of coupon PINs
PIN_SECRET=replace_with_a_strong_random_secret

# ─── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── AI / FreeLLMAPI ────────────────────────────────────
FRELLMAPI_URL=http://localhost:3001
FRELLMAPI_KEY=your_freellmapi_key_here
